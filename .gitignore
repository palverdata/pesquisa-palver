# R
.Rhistory
.RData
.RDataTmp
.Rprofile.local
.Renviron
.Rproj.user/

# Microdados de pesquisa nunca entram no repo (ver politica de dados no README).
ondas/*/dados/*
!ondas/*/dados/.gitkeep

# Resultados: gerados pelo motor a partir do que esta versionado.
ondas/*/output/*
!ondas/*/output/.gitkeep

# Microdados de origem das margens: grandes, publicos e reprodutiveis pela
# fonte oficial. O que se versiona e o derivado, em margens/.
insumos/**
!insumos/*/
!insumos/*/.gitkeep

# Formatos de microdado, em qualquer lugar
*.sav
*.dta
*.rds
*.RDS

# CSV bruto de pesquisa deixado fora de ondas/*/dados/ por engano
/survey-*.csv

# Projeto-modelo de referencia (consulta local, fora do repo)
/00_RProject/

# Sistema operacional e configuracao de editor
.DS_Store
Thumbs.db
.claude/

# Microdados deixados na raiz. O arquivo com ip_address NUNCA pode ser commitado:
# o repositorio e publico e o briefing exige derivar as variaveis e descartar o IP.
/*.xlsx
/*.csv

# Paradata da onda: mesmos respondentes do export de dados/, com colunas de
# fingerprint, ip_hash e user_agent. Sensivel, nunca versionado.
ondas/*/paradata/*
!ondas/*/paradata/.gitkeep

# Testes A/B de recrutamento: microdados dentro, agregados fora.
testes/*/dados/*
!testes/*/dados/.gitkeep
testes/*/output/*
!testes/*/output/.gitkeep

# Saidas de experimento de calibracao (regeneraveis pelos scripts)
/experimentos/
