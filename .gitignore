# R
.Rhistory
.RData
.RDataTmp
.Rprofile.local
.Renviron
.Rproj.user/

# Microdados de pesquisa nunca entram no repo (ver politica de dados no README).
ondas/*/dados/*
!ondas/*/dados/.gitkeep

# Resultados: gerados pelo motor a partir do que esta versionado.
ondas/*/output/*
!ondas/*/output/.gitkeep

# Microdados de origem das margens: grandes, publicos e reprodutiveis pela
# fonte oficial. O que se versiona e o derivado, em margens/.
insumos/**
!insumos/README.md
!insumos/*/
!insumos/*/.gitkeep

# Excecao: crosswalk curado de municipio (codigo IBGE/TSE, populacao,
# classificacao Capital/RM/Interior) -- derivado com reconciliacao manual entre
# fontes, nao reproduzivel so a partir da fonte oficial. Versionado como as
# margens, nao como um microdado descartavel.
!insumos/municipios_brasil.yaml

# Formatos de microdado, em qualquer lugar
*.sav
*.dta
*.rds
*.RDS

# CSV bruto de pesquisa deixado fora de ondas/*/dados/ por engano
/survey-*.csv

# Projeto-modelo de referencia (consulta local, fora do repo)
/00_RProject/

# Sistema operacional
.DS_Store
Thumbs.db
.claude
.git
.positai
