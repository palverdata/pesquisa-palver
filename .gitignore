!insumos/municipios_brasil.yaml

*.sav
*.dta
*.rds
*.RDS

/00_RProject/

.DS_Store
Thumbs.db
.claude/

/*.xlsx
/*.csv
/*.json

/docs/

# O mapping e resposta individual.
ondas/*/norm/mapping/

# Ambiente Python da normalizacao.
normalizacao/.venv/
*.egg-info/
__pycache__/
*.pyc
.pytest_cache/
